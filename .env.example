# Copy this file to `.env.local` and fill in the values.
#   cp .env.example .env.local

# Backend API base URL.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Dev-only: bypass Google OAuth and inject a mock user so the dashboard
# is reachable without a running backend. Set to 'true' to enable.
# Leave 'false' (or unset) for the real OAuth flow.
NEXT_PUBLIC_MOCK_AUTH=false

# Supabase — public/anon credentials, safe to ship in the client bundle.
# Do NOT put the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
